<section class="search page-width">
  <h1>{{ 'search.title' | t }}</h1>
  <form class="search-inline" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="SearchPage">{{ 'general.search' | t }}</label>
    <input id="SearchPage" type="search" name="q" value="{{ search.terms }}" placeholder="{{ 'general.search_placeholder' | t }}" minlength="3">
    <button type="submit" class="button">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.too_short -%}
    <p class="notice">{{ 'search.too_short' | t }}</p>
  {%- elsif search.performed -%}
    {%- paginate search.results by 48 -%}
      <p class="search__count" role="status">{{ 'search.results_count' | t: terms: search.terms, count: search.results_count }}</p>
      {%- if search.results.size > 0 -%}
        <ul class="grid" role="list">
          {%- for product in search.results -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="empty">{{ 'search.no_results' | t }}</p>
      {%- endif -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "settings": []
}
{% endschema %}
