{%- if section.settings.text != blank -%}
  <div class="announcement">
    <div class="page-width">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "settings": [
    { "type": "text", "id": "text", "label": "t:sections.announcement_bar.text", "default": "" },
    { "type": "url", "id": "link", "label": "t:sections.announcement_bar.link" }
  ],
  "presets": [{ "name": "t:sections.announcement_bar.name" }]
}
{% endschema %}
