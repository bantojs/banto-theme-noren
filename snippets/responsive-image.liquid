{%- comment -%}
  画像。Banto は縮小した段（サムネイル・中間・本画像。Banto v0.7 から）を持つので、image_tag が持っている段を srcset に並べ、
  端末に合う大きさを選ばせる（Banto の docs/themes.md「フィルター」）。
  - image: 画像
  - sizes: sizes 属性
  - alt: 代わりの文字（任意。無ければ画像の alt）
  - loading: lazy（既定）/ eager
  - class: img のクラス
{%- endcomment -%}
{%- liquid
  assign alt_text = alt | default: image.alt
  assign load = loading | default: 'lazy'
  assign img_sizes = sizes | default: '100vw'
-%}
{%- if load == 'eager' -%}
  {{- image | image_url | image_tag: alt: alt_text, sizes: img_sizes, loading: 'eager', fetchpriority: 'high', decoding: 'async', class: class -}}
{%- else -%}
  {{- image | image_url | image_tag: alt: alt_text, sizes: img_sizes, loading: 'lazy', decoding: 'async', class: class -}}
{%- endif -%}
